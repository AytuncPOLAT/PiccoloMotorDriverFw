{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "Release",
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"label": "CMake: configure Release",
			"type": "shell",
			"command": "cmake --preset Release",
			"group": "build",
			"problemMatcher": [],
			"detail": "Configure the Release build directory"
		},
		{
			"label": "build-and-flash",
			"type": "shell",
			"command": "cmake --build build/Release",
			"dependsOn": "CMake: configure Release",
			"group": "build",
			"problemMatcher": [],
			"detail": "Build the firmware (flashing handled by GDB debug session)"
		},
		{
			"type": "cmake",
			"label": "CMake: clean",
			"command": "clean",
			"preset": "Release",
			"problemMatcher": [],
			"detail": "CMake template clean task"
		},
		{
			"label": "Build DRV8353S Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}\\build\\Release"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "PiccoloGui: configure Windows",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}\\PiccoloGui",
				"-B",
				"${workspaceFolder}\\PiccoloGui\\build_windows",
				"-G",
				"Visual Studio 16 2019",
				"-A",
				"x64",
				"-DFETCHCONTENT_SOURCE_DIR_GLFW=${workspaceFolder}\\PiccoloGui\\build\\_deps\\glfw-src",
				"-DFETCHCONTENT_SOURCE_DIR_IMGUI=${workspaceFolder}\\PiccoloGui\\build\\_deps\\imgui-src",
				"-DFETCHCONTENT_SOURCE_DIR_IMPLOT=${workspaceFolder}\\PiccoloGui\\build\\_deps\\implot-src"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "PiccoloGui: build Windows Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}\\PiccoloGui\\build_windows",
				"--config",
				"Release",
				"--target",
				"PiccoloGui",
				"--parallel"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}